                },
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "alloc",
                      "query": "sum:kubernetes_state.node.cpu_allocatable{$cluster}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "alloc",
                      "alias": "allocatable"
                    }
                  ],
                  "display_type": "line",
                  "style": {
