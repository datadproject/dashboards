                },
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "alloc",
                      "query": "sum:kubernetes_state.node.memory_allocatable{$cluster}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "alloc",
                      "alias": "allocatable",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "byte"
                        }
                      }
