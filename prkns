                    }
                  ],
                  "formulas": [
                    {
                      "formula": "100 * r / a"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 90,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">",
                      "value": 75,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<=",
