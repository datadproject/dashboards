{
  "title": "Perkins | EKS Clusters & ULP Services",
  "description": "Cluster health, workloads, container resources, ULP Celery workers (APM), Postgres/Redis, Python runtime, releases and logs for the Perkins dev and prod EKS clusters.",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "notify_list": [],
  "template_variables": [
    { "name": "cluster", "prefix": "kube_cluster_name", "available_values": ["perkins-gcralsp-development-primary-ekscluster", "perkins-gcralsp-production-primary-ekscluster"], "defaults": ["perkins-gcralsp-development-primary-ekscluster"] },
    { "name": "namespace", "prefix": "kube_namespace", "available_values": [], "defaults": ["*"] },
    { "name": "env", "prefix": "env", "available_values": [], "defaults": ["development"] },
    { "name": "service", "prefix": "service", "available_values": [], "defaults": ["ulp*"] }
  ],
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "**Perkins EKS clusters** · switch dev/prod with the `cluster` filter · narrow pods and containers with `namespace`.\n\nThe APM sections (Celery, Django web, Postgres/Redis, Python runtime, releases) use `env` and `service`; dev traces use `env:development`. **Prod currently sends no traces**, so those sections stay empty on prod until tracing is turned on. Sections marked *blank unless...* fill in once that Datadog integration is enabled; delete any you don't need. Color thresholds are starting points.",
        "background_color": "yellow",
        "font_size": "14",
        "text_align": "left",
        "vertical_align": "top",
        "show_tick": false,
        "tick_pos": "50%",
        "tick_edge": "left",
        "has_padding": true
      },
      "layout": { "x": 0, "y": 0, "width": 12, "height": 2 }
    },
    {
      "definition": {
        "title": "Cluster health",
        "type": "group",
        "layout_type": "ordered",
        "background_color": "vivid_blue",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "title": "Nodes ready",
              "type": "query_value",
              "requests": [ { "response_format": "scalar",
                "queries": [ { "data_source": "metrics", "name": "q", "query": "sum:kubernetes_state.node.by_condition{$cluster,condition:ready,status:true}", "aggregator": "last" } ],
                "formulas": [ { "formula": "q" } ] } ],
              "autoscale": true, "precision": 0
            },
            "layout": { "x": 0, "y": 0, "width": 2, "height": 2 }
          },
          {
            "definition": {
              "title": "Nodes not ready",
              "type": "query_value",
              "requests": [ { "response_format": "scalar",
                "queries": [ { "data_source": "metrics", "name": "q", "query": "sum:kubernetes_state.node.by_condition{$cluster,condition:ready,!status:true}", "aggregator": "last" } ],
                "formulas": [ { "formula": "q" } ],
                "conditional_formats": [
                  { "comparator": ">", "value": 0, "palette": "white_on_red" },
                  { "comparator": "<=", "value": 0, "palette": "white_on_green" } ] } ],
              "autoscale": true, "precision": 0
            },
            "layout": { "x": 2, "y": 0, "width": 2, "height": 2 }
          },
          {
            "definition": {
              "title": "Pods running",
              "type": "query_value",
              "requests": [ { "response_format": "scalar",
                "queries": [ { "data_source": "metrics", "name": "q", "query": "sum:kubernetes_state.pod.status_phase{$cluster,$namespace,pod_phase:running}", "aggregator": "last" } ],
                "formulas": [ { "formula": "q" } ] } ],
              "autoscale": true, "precision": 0
            },
            "layout": { "x": 4, "y": 0, "width": 2, "height": 2 }
          },
          {
            "definition": {
              "title": "Pods pending",
              "type": "query_value",
              "requests": [ { "response_format": "scalar",
                "queries": [ { "data_source": "metrics", "name": "q", "query": "sum:kubernetes_state.pod.status_phase{$cluster,$namespace,pod_phase:pending}", "aggregator": "last" } ],
                "formulas": [ { "formula": "q" } ],
                "conditional_formats": [
                  { "comparator": ">", "value": 0, "palette": "white_on_yellow" },
                  { "comparator": "<=", "value": 0, "palette": "white_on_green" } ] } ],
              "autoscale": true, "precision": 0
            },
            "layout": { "x": 6, "y": 0, "width": 2, "height": 2 }
          },
          {
            "definition": {
              "title": "Pods failed",
              "type": "query_value",
              "requests": [ { "response_format": "scalar",
                "queries": [ { "data_source": "metrics", "name": "q", "query": "sum:kubernetes_state.pod.status_phase{$cluster,$namespace,pod_phase:failed}", "aggregator": "last" } ],
                "formulas": [ { "formula": "q" } ],
                "conditional_formats": [
                  { "comparator": ">", "value": 0, "palette": "white_on_red" },
                  { "comparator": "<=", "value": 0, "palette": "white_on_green" } ] } ],
              "autoscale": true, "precision": 0
            },
            "layout": { "x": 8, "y": 0, "width": 2, "height": 2 }
          },
          {
            "definition": {
              "title": "CrashLoopBackOff (blank = none)",
              "type": "query_value",
              "requests": [ { "response_format": "scalar",
                "queries": [ { "data_source": "metrics", "name": "q", "query": "sum:kubernetes_state.container.status_report.count.waiting{$cluster,$namespace,reason:crashloopbackoff}", "aggregator": "last" } ],
                "formulas": [ { "formula": "q" } ],
                "conditional_formats": [
                  { "comparator": ">", "value": 0, "palette": "white_on_red" },
                  { "comparator": "<=", "value": 0, "palette": "white_on_green" } ] } ],
              "autoscale": true, "precision": 0
            },
            "layout": { "x": 10, "y": 0, "width": 2, "height": 2 }
          },
          {
            "definition": {
              "title": "Node CPU used %",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [ { "response_format": "timeseries",
                "queries": [ { "data_source": "metrics", "name": "q", "query": "avg:system.cpu.idle{$cluster} by {host}" } ],
                "formulas": [ { "formula": "100 - q", "number_format": { "unit": { "type": "custom_unit_label", "label": "%" } } } ],
                "display_type": "line" } ],
              "markers": [ { "value": "y = 80", "display_type": "warning dashed", "label": "80%" } ]
            },
            "layout": { "x": 0, "y": 2, "width": 6, "height": 3 }
          },
          {
            "definition": {
              "title": "Node memory used %",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [ { "response_format": "timeseries",
                "queries": [ { "data_source": "metrics", "name": "q", "query": "avg:system.mem.pct_usable{$cluster} by {host}" } ],
                "formulas": [ { "formula": "100 * (1 - q)", "number_format": { "unit": { "type": "custom_unit_label", "label": "%" } } } ],
                "display_type": "line" } ],
              "markers": [ { "value": "y = 85", "display_type": "warning dashed", "label": "85%" } ]
            },
            "layout": { "x": 6, "y": 2, "width": 6, "height": 3 }
          },
          {
            "definition": {
              "title": "CPU requested (% of allocatable)",
              "type": "query_value",
              "requests": [ { "response_format": "scalar",
                "queries": [
                  { "data_source": "metrics", "name": "r", "query": "sum:kubernetes_state.container.cpu_requested{$cluster}", "aggregator": "last" },
                  { "data_source": "metrics", "name": "a", "query": "sum:kubernetes_state.node.cpu_allocatable{$cluster}", "aggregator": "last" } ],
                "formulas": [ { "formula": "100 * r / a" } ],
                "conditional_formats": [
                  { "comparator": ">", "value": 90, "palette": "white_on_red" },
                  { "comparator": ">", "value": 75, "palette": "white_on_yellow" },
                  { "comparator": "<=", "value": 75, "palette": "white_on_green" } ] } ],
              "autoscale": true, "custom_unit": "%", "precision": 0
            },
            "layout": { "x": 0, "y": 5, "width": 3, "height": 2 }
          },
          {
            "definition": {
              "title": "Memory requested (% of allocatable)",
              "type": "query_value",
              "requests": [ { "response_format": "scalar",
                "queries": [
                  { "data_source": "metrics", "name": "r", "query": "sum:kubernetes_state.container.memory_requested{$cluster}", "aggregator": "last" },
                  { "data_source": "metrics", "name": "a", "query": "sum:kubernetes_state.node.memory_allocatable{$cluster}", "aggregator": "last" } ],
                "formulas": [ { "formula": "100 * r / a" } ],
                "conditional_formats": [
                  { "comparator": ">", "value": 90, "palette": "white_on_red" },
                  { "comparator": ">", "value": 75, "palette": "white_on_yellow" },
                  { "comparator": "<=", "value": 75, "palette": "white_on_green" } ] } ],
              "autoscale": true, "custom_unit": "%", "precision": 0
            },
            "layout": { "x": 3, "y": 5, "width": 3, "height": 2 }
          },
          {
            "definition": {
              "title": "CPU limits (% of allocatable)",
              "type": "query_value",
              "requests": [ { "response_format": "scalar",
                "queries": [
                  { "data_source": "metrics", "name": "l", "query": "sum:kubernetes_state.container.cpu_limit{$cluster}", "aggregator": "last" },
                  { "data_source": "metrics", "name": "a", "query": "sum:kubernetes_state.node.cpu_allocatable{$cluster}", "aggregator": "last" } ],
                "formulas": [ { "formula": "100 * l / a" } ],
                "conditional_formats": [
                  { "comparator": ">", "value": 100, "palette": "white_on_yellow" },
                  { "comparator": "<=", "value": 100, "palette": "white_on_green" } ] } ],
              "autoscale": true, "custom_unit": "%", "precision": 0
            },
            "layout": { "x": 6, "y": 5, "width": 3, "height": 2 }
          },
          {
            "definition": {
              "title": "Memory limits (% of allocatable)",
              "type": "query_value",
              "requests": [ { "response_format": "scalar",
                "queries": [
                  { "data_source": "metrics", "name": "l", "query": "sum:kubernetes_state.container.memory_limit{$cluster}", "aggregator": "last" },
                  { "data_source": "metrics", "name": "a", "query": "sum:kubernetes_state.node.memory_allocatable{$cluster}", "aggregator": "last" } ],
                "formulas": [ { "formula": "100 * l / a" } ],
                "conditional_formats": [
                  { "comparator": ">", "value": 100, "palette": "white_on_yellow" },
                  { "comparator": "<=", "value": 100, "palette": "white_on_green" } ] } ],
              "autoscale": true, "custom_unit": "%", "precision": 0
            },
            "layout": { "x": 9, "y": 5, "width": 3, "height": 2 }
          }
        ]
      },
      "layout": { "x": 0, "y": 2, "width": 12, "height": 8 }
    },
    {
      "definition": {
        "title": "Capacity, nodes, network and disk",
        "type": "group",
        "layout_type": "ordered",
        "background_color": "blue",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "title": "CPU: capacity, allocatable, requested and used (cores)",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [ { "response_format": "timeseries",
                "queries": [
                  { "data_source": "metrics", "name": "cap", "query": "sum:kubernetes_state.node.cpu_capacity{$cluster}" },
                  { "data_source": "metrics", "name": "alloc", "query": "sum:kubernetes_state.node.cpu_allocatable{$cluster}" },
                  { "data_source": "metrics", "name": "req", "query": "sum:kubernetes_state.container.cpu_requested{$cluster}" },
                  { "data_source": "metrics", "name": "used", "query": "sum:kubernetes.cpu.usage.total{$cluster}" } ],
                "formulas": [
                  { "formula": "cap", "alias": "capacity", "number_format": { "unit": { "type": "custom_unit_label", "label": "cores" } } },
                  { "formula": "alloc", "alias": "allocatable", "number_format": { "unit": { "type": "custom_unit_label", "label": "cores" } } },
                  { "formula": "req", "alias": "requested", "number_format": { "unit": { "type": "custom_unit_label", "label": "cores" } } },
                  { "formula": "used / 1000000000", "alias": "used", "number_format": { "unit": { "type": "custom_unit_label", "label": "cores" } } } ],
                "display_type": "line" } ]
            },
            "layout": { "x": 0, "y": 0, "width": 6, "height": 3 }
          },
          {
            "definition": {
              "title": "Memory: capacity, allocatable, requested and used",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [ { "response_format": "timeseries",
                "queries": [
                  { "data_source": "metrics", "name": "cap", "query": "sum:kubernetes_state.node.memory_capacity{$cluster}" },
                  { "data_source": "metrics", "name": "alloc", "query": "sum:kubernetes_state.node.memory_allocatable{$cluster}" },
                  { "data_source": "metrics", "name": "req", "query": "sum:kubernetes_state.container.memory_requested{$cluster}" },
                  { "data_source": "metrics", "name": "used", "query": "sum:kubernetes.memory.usage{$cluster}" } ],
                "formulas": [
                  { "formula": "cap", "alias": "capacity", "number_format": { "unit": { "type": "canonical_unit", "unit_name": "byte" } } },
                  { "formula": "alloc", "alias": "allocatable", "number_format": { "unit": { "type": "canonical_unit", "unit_name": "byte" } } },
                  { "formula": "req", "alias": "requested", "number_format": { "unit": { "type": "canonical_unit", "unit_name": "byte" } } },
                  { "formula": "used", "alias": "used", "number_format": { "unit": { "type": "canonical_unit", "unit_name": "byte" } } } ],
                "display_type": "line" } ]
            },
            "layout": { "x": 6, "y": 0, "width": 6, "height": 3 }
          },
          {
            "definition": {
              "title": "Pods: capacity, allocatable and running",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [ { "response_format": "timeseries",
                "queries": [
                  { "data_source": "metrics", "name": "cap", "query": "sum:kubernetes_state.node.pods_capacity{$cluster}" },
                  { "data_source": "metrics", "name": "alloc", "query": "sum:kubernetes_state.node.pods_allocatable{$cluster}" },
                  { "data_source": "metrics", "name": "run", "query": "sum:kubernetes_state.pod.status_phase{$cluster,pod_phase:running}" } ],
                "formulas": [
                  { "formula": "cap", "alias": "capacity" },
                  { "formula": "alloc", "alias": "allocatable" },
                  { "formula": "run", "alias": "running" } ],
                "display_type": "line" } ]
            },
            "layout": { "x": 0, "y": 3, "width": 4, "height": 3 }
          },
          {
            "definition": {
              "title": "Ready pods",
              "type": "query_value",
              "requests": [ { "response_format": "scalar",
                "queries": [
                  { "data_source": "metrics", "name": "ready", "query": "sum:kubernetes_state.pod.ready{$cluster,$namespace,condition:true}", "aggregator": "last" },
                  { "data_source": "metrics", "name": "run", "query": "sum:kubernetes_state.pod.status_phase{$cluster,$namespace,pod_phase:running}", "aggregator": "last" } ],
                "formulas": [ { "formula": "100 * ready / run" } ],
                "conditional_formats": [
                  { "comparator": "<", "value": 90, "palette": "white_on_red" },
                  { "comparator": "<", "value": 98, "palette": "white_on_yellow" },
                  { "comparator": ">=", "value": 98, "palette": "white_on_green" } ] } ],
              "autoscale": true, "custom_unit": "%", "precision": 0
            },
            "layout": { "x": 4, "y": 3, "width": 2, "height": 3 }
          },
          {
            "definition": {
              "title": "Kubelets up",
              "type": "check_status",
              "check": "kubernetes.kubelet.check",
              "grouping": "cluster",
              "group_by": [],
              "tags": ["$cluster"]
            },
            "layout": { "x": 6, "y": 3, "width": 2, "height": 3 }
          },
          {
            "definition": {
              "title": "Nodes under pressure (blank = none)",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [ { "response_format": "timeseries",
                "queries": [ { "data_source": "metrics", "name": "q", "query": "sum:kubernetes_state.node.by_condition{$cluster,!condition:ready,status:true} by {condition}" } ],
                "formulas": [ { "formula": "q" } ],
                "display_type": "bars" } ]
            },
            "layout": { "x": 8, "y": 3, "width": 4, "height": 3 }
          },
          {
            "definition": {
              "title": "Network rate (cluster total)",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [ { "response_format": "timeseries",
                "queries": [
                  { "data_source": "metrics", "name": "rx", "query": "sum:kubernetes.network.rx_bytes{$cluster}" },
                  { "data_source": "metrics", "name": "tx", "query": "sum:kubernetes.network.tx_bytes{$cluster}" } ],
                "formulas": [
                  { "formula": "rx", "alias": "received", "number_format": { "unit": { "type": "canonical_unit", "unit_name": "byte", "per_unit_name": "second" } } },
                  { "formula": "tx", "alias": "sent", "number_format": { "unit": { "type": "canonical_unit", "unit_name": "byte", "per_unit_name": "second" } } } ],
                "display_type": "line" } ]
            },
            "layout": { "x": 0, "y": 6, "width": 4, "height": 3 }
          },
          {
            "definition": {
              "title": "Network errors and dropped packets",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [ { "response_format": "timeseries",
                "queries": [
                  { "data_source": "metrics", "name": "rxe", "query": "sum:kubernetes.network.rx_errors{$cluster}" },
                  { "data_source": "metrics", "name": "txe", "query": "sum:kubernetes.network.tx_errors{$cluster}" },
                  { "data_source": "metrics", "name": "rxd", "query": "sum:kubernetes.network.rx_dropped{$cluster}" },
                  { "data_source": "metrics", "name": "txd", "query": "sum:kubernetes.network.tx_dropped{$cluster}" } ],
                "formulas": [
                  { "formula": "rxe", "alias": "receive errors" },
                  { "formula": "txe", "alias": "send errors" },
                  { "formula": "rxd", "alias": "received dropped" },
                  { "formula": "txd", "alias": "sent dropped" } ],
                "display_type": "line" } ]
            },
            "layout": { "x": 4, "y": 6, "width": 4, "height": 3 }
          },
          {
            "definition": {
              "title": "Disk I/O (cluster total)",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [ { "response_format": "timeseries",
                "queries": [
                  { "data_source": "metrics", "name": "rd", "query": "sum:kubernetes.io.read_bytes{$cluster}" },
                  { "data_source": "metrics", "name": "wr", "query": "sum:kubernetes.io.write_bytes{$cluster}" } ],
                "formulas": [
                  { "formula": "rd", "alias": "read", "number_format": { "unit": { "type": "canonical_unit", "unit_name": "byte", "per_unit_name": "second" } } },
                  { "formula": "wr", "alias": "write", "number_format": { "unit": { "type": "canonical_unit", "unit_name": "byte", "per_unit_name": "second" } } } ],
                "display_type": "line" } ]
            },
            "layout": { "x": 8, "y": 6, "width": 4, "height": 3 }
          }
        ]
      },
      "layout": { "x": 0, "y": 10, "width": 12, "height": 10 }
    },
    {
      "definition": {
        "title": "Workloads",
        "type": "group",
        "layout_type": "ordered",
        "background_color": "vivid_purple",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "title": "Pods by phase",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [ { "response_format": "timeseries",
                "queries": [ { "data_source": "metrics", "name": "q", "query": "sum:kubernetes_state.pod.status_phase{$cluster,$namespace} by {pod_phase}" } ],
                "formulas": [ { "formula": "q" } ],
                "display_type": "bars" } ]
            },
            "layout": { "x": 0, "y": 0, "width": 6, "height": 3 }
          },
          {
            "definition": {
              "title": "Container restarts by deployment",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [ { "response_format": "timeseries",
                "queries": [ { "data_source": "metrics", "name": "q", "query": "sum:kubernetes_state.container.restarts{$cluster,$namespace} by {kube_deployment}" } ],
                "formulas": [ { "formula": "monotonic_diff(q)" } ],
                "display_type": "bars" } ]
            },
            "layout": { "x": 6, "y": 0, "width": 6, "height": 3 }
          },
          {
            "definition": {
              "title": "Waiting containers by reason (CrashLoopBackOff, ImagePullBackOff...)",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [ { "response_format": "timeseries",
                "queries": [ { "data_source": "metrics", "name": "q", "query": "sum:kubernetes_state.container.status_report.count.waiting{$cluster,$namespace} by {reason}" } ],
                "formulas": [ { "formula": "q" } ],
                "display_type": "bars" } ]
            },
            "layout": { "x": 0, "y": 3, "width": 6, "height": 3 }
          },
          {
            "definition": {
              "title": "Terminated containers by reason (OOMKilled, Error...)",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [ { "response_format": "timeseries",
                "queries": [ { "data_source": "metrics", "name": "q", "query": "sum:kubernetes_state.container.status_report.count.terminated{$cluster,$namespace} by {reason}" } ],
                "formulas": [ { "formula": "q" } ],
                "display_type": "bars" } ]
            },
            "layout": { "x": 6, "y": 3, "width": 6, "height": 3 }
          },
          {
            "definition": {
              "title": "Deployments missing replicas (desired - available)",
              "type": "toplist",
              "requests": [ { "response_format": "scalar",
                "queries": [
                  { "data_source": "metrics", "name": "d", "query": "sum:kubernetes_state.deployment.replicas_desired{$cluster,$namespace} by {kube_deployment}", "aggregator": "last" },
                  { "data_source": "metrics", "name": "a", "query": "sum:kubernetes_state.deployment.replicas_available{$cluster,$namespace} by {kube_deployment}", "aggregator": "last" } ],
                "formulas": [ { "formula": "d - a", "limit": { "count": 10, "order": "desc" } } ] } ]
            },
            "layout": { "x": 0, "y": 6, "width": 6, "height": 4 }
          },
          {
            "definition": {
              "title": "Autoscalers: % of max replicas in use",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [ { "response_format": "timeseries",
                "queries": [
                  { "data_source": "metrics", "name": "cur", "query": "sum:kubernetes_state.hpa.current_replicas{$cluster,$namespace} by {horizontalpodautoscaler}" },
                  { "data_source": "metrics", "name": "mx", "query": "sum:kubernetes_state.hpa.max_replicas{$cluster,$namespace} by {horizontalpodautoscaler}" } ],
                "formulas": [ { "formula": "100 * cur / mx", "number_format": { "unit": { "type": "custom_unit_label", "label": "%" } } } ],
                "display_type": "line" } ],
              "markers": [ { "value": "y = 100", "display_type": "error dashed", "label": "at max" } ]
            },
            "layout": { "x": 6, "y": 6, "width": 6, "height": 4 }
          }
