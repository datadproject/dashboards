{
  "title": "Perkins | ULP Application & EKS Clusters",
  "description": "App health (ULP Celery and Django via APM), Postgres/Redis, releases, and full Kubernetes health for the Perkins dev and prod EKS clusters.",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "notify_list": [],
  "template_variables": [
    {
      "name": "cluster",
      "prefix": "kube_cluster_name",
      "available_values": [
        "perkins-gcralsp-development-primary-ekscluster",
        "perkins-gcralsp-production-primary-ekscluster"
      ],
      "defaults": [
        "perkins-gcralsp-development-primary-ekscluster"
      ]
    },
    {
      "name": "namespace",
      "prefix": "kube_namespace",
      "available_values": [],
      "defaults": [
        "*"
      ]
    },
    {
      "name": "env",
      "prefix": "env",
      "available_values": [],
      "defaults": [
        "development"
      ]
    },
    {
      "name": "service",
      "prefix": "service",
      "available_values": [],
      "defaults": [
        "ulp*"
      ]
    }
  ],
  "widgets": [
    {
      "definition": {
        "title": "Application health (ULP)",
        "type": "group",
        "layout_type": "ordered",
        "background_color": "vivid_purple",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "title": "Tasks / sec",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "h",
                      "query": "sum:trace.celery.run.hits{$env,$service}.as_rate()",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "h"
                    }
                  ]
                }
              ],
              "autoscale": true,
              "precision": 2,
              "timeseries_background": {
                "type": "area",
                "yaxis": {
                  "include_zero": true
                }
              }
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "Task error rate",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "e",
                      "query": "sum:trace.celery.run.errors{$env,$service}.as_count()",
                      "aggregator": "sum"
                    },
                    {
                      "data_source": "metrics",
                      "name": "h",
                      "query": "sum:trace.celery.run.hits{$env,$service}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "100 * default_zero(e) / h"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 5,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">",
                      "value": 1,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<=",
                      "value": 1,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ],
              "autoscale": true,
              "custom_unit": "%",
              "precision": 2
            },
            "layout": {
              "x": 3,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "Task duration p95",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "p95:trace.celery.run{$env,$service}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ]
                }
              ],
              "autoscale": true,
              "precision": 2,
              "timeseries_background": {
                "type": "area",
                "yaxis": {
                  "include_zero": true
                }
              }
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "Postgres query p95",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "p95:trace.postgres.query{$env,$service}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 0.1,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">",
                      "value": 0.02,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<=",
                      "value": 0.02,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ],
              "autoscale": true,
              "precision": 2
            },
            "layout": {
              "x": 9,
              "y": 0,
              "width": 3,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },
    {
      "definition": {
        "title": "Cluster health",
        "type": "group",
        "layout_type": "ordered",
        "background_color": "vivid_blue",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "title": "Nodes ready",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:kubernetes_state.node.by_condition{$cluster,condition:ready,status:true}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q",
                      "number_format": {
                        "unit": {
                          "type": "custom_unit_label",
                          "label": "nodes"
                        }
                      }
                    }
                  ]
                }
              ],
              "autoscale": true,
              "precision": 0,
              "timeseries_background": {
                "type": "bars",
                "yaxis": {
                  "include_zero": true
                }
              }
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "Nodes not ready",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:kubernetes_state.node.by_condition{$cluster,condition:ready,!status:true}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q",
                      "number_format": {
                        "unit": {
                          "type": "custom_unit_label",
                          "label": "nodes"
                        }
                      }
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 0,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": "<=",
                      "value": 0,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ],
              "autoscale": true,
              "precision": 0
            },
            "layout": {
              "x": 3,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "Pods running",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:kubernetes_state.pod.status_phase{$cluster,$namespace,pod_phase:running}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q",
                      "number_format": {
                        "unit": {
                          "type": "custom_unit_label",
                          "label": "pods"
                        }
                      }
                    }
                  ]
                }
              ],
              "autoscale": true,
              "precision": 0,
              "timeseries_background": {
                "type": "area",
                "yaxis": {
                  "include_zero": true
                }
              }
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "Pods running but not ready",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "run",
                      "query": "sum:kubernetes_state.pod.status_phase{$cluster,$namespace,pod_phase:running}",
                      "aggregator": "last"
                    },
                    {
                      "data_source": "metrics",
                      "name": "ready",
                      "query": "sum:kubernetes_state.pod.ready{$cluster,$namespace,condition:true}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "run - ready",
                      "number_format": {
                        "unit": {
                          "type": "custom_unit_label",
                          "label": "pods"
                        }
                      }
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 0,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<=",
                      "value": 0,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ],
              "autoscale": true,
              "precision": 0
            },
            "layout": {
              "x": 9,
              "y": 0,
              "width": 3,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 3,
        "width": 12,
        "height": 3
      }
    },
    {
      "definition": {
        "title": "Celery workers",
        "type": "group",
        "layout_type": "ordered",
        "background_color": "vivid_purple",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "title": "Worker services at a glance",
              "type": "query_table",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "h",
                      "query": "sum:trace.celery.run.hits{$env,$service} by {service}.as_count()",
                      "aggregator": "sum"
                    },
                    {
                      "data_source": "metrics",
                      "name": "e",
                      "query": "sum:trace.celery.run.errors{$env,$service} by {service}.as_count()",
                      "aggregator": "sum"
                    },
                    {
                      "data_source": "metrics",
                      "name": "p",
                      "query": "p95:trace.celery.run{$env,$service} by {service}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "h",
                      "alias": "tasks",
                      "limit": {
                        "count": 25,
                        "order": "desc"
                      }
                    },
                    {
                      "formula": "e",
                      "alias": "errors"
                    },
                    {
                      "formula": "100 * default_zero(e) / h",
                      "alias": "error %"
                    },
                    {
                      "formula": "p",
                      "alias": "p95 duration"
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 4
            }
          },
          {
            "definition": {
              "title": "Tasks / sec by worker service",
              "type": "timeseries",
              "show_legend": false,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:trace.celery.run.hits{$env,$service} by {service}.as_rate()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "display_type": "area",
                  "style": {
                    "palette": "purple",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 4,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Task duration p95 by worker service",
              "type": "timeseries",
              "show_legend": false,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "p95:trace.celery.run{$env,$service} by {service}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 4,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Task errors by worker service (blank = none)",
              "type": "timeseries",
              "show_legend": false,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:trace.celery.run.errors{$env,$service} by {service}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "display_type": "bars",
                  "style": {
                    "palette": "warm",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 7,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Tasks / sec: now vs same time last week",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "horizontal",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:trace.celery.run.hits{$env,$service}.as_rate()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q",
                      "alias": "now"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "purple",
                    "line_type": "solid",
                    "line_width": "thick"
                  }
                },
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "w",
                      "query": "sum:trace.celery.run.hits{$env,$service}.as_rate()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "week_before(w)",
                      "alias": "last week"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "gray",
                    "line_type": "dashed",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 7,
              "width": 6,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 6,
        "width": 12,
        "height": 11
      }
    },
    {
      "definition": {
