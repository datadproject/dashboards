{
  "title": "Perkins | ULP Application & EKS Clusters",
  "description": "Left column: ULP application (APM, logs). Right column: Kubernetes, built from Datadog's Kubernetes Overview widgets plus extra troubleshooting.",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "notify_list": [],
  "template_variables": [
    {
      "name": "cluster",
      "prefix": "kube_cluster_name",
      "available_values": [
        "perkins-gcralsp-development-primary-ekscluster",
        "perkins-gcralsp-production-primary-ekscluster"
      ],
      "defaults": [
        "perkins-gcralsp-development-primary-ekscluster"
      ]
    },
    {
      "name": "namespace",
      "prefix": "kube_namespace",
      "available_values": [],
      "defaults": [
        "*"
      ]
    },
    {
      "name": "deployment",
      "prefix": "kube_deployment",
      "available_values": [],
      "defaults": [
        "*"
      ]
    },
    {
      "name": "node",
      "prefix": "kube_node",
      "available_values": [],
      "defaults": [
        "*"
      ]
    },
    {
      "name": "env",
      "prefix": "env",
      "available_values": [],
      "defaults": [
        "development"
      ]
    },
    {
      "name": "service",
      "prefix": "service",
      "available_values": [],
      "defaults": [
        "ulp*"
      ]
    }
  ],
  "widgets": [
    {
      "definition": {
        "title": "Application health (ULP)",
        "type": "group",
        "layout_type": "ordered",
        "background_color": "vivid_purple",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "title": "Tasks / sec",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "h",
                      "query": "sum:trace.celery.run.hits{$env,$service}.as_rate()",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "h"
                    }
                  ]
                }
              ],
              "autoscale": true,
              "precision": 2,
              "timeseries_background": {
                "type": "area",
                "yaxis": {
                  "include_zero": true
                }
              }
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "Task error rate",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "e",
                      "query": "sum:trace.celery.run.errors{$env,$service}.as_count()",
                      "aggregator": "sum"
                    },
                    {
                      "data_source": "metrics",
                      "name": "h",
                      "query": "sum:trace.celery.run.hits{$env,$service}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "100 * default_zero(e) / h"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 5,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">",
                      "value": 1,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<=",
                      "value": 1,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ],
              "autoscale": true,
              "custom_unit": "%",
              "precision": 2
            },
            "layout": {
              "x": 3,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "Task duration p95",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "p95:trace.celery.run{$env,$service}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ]
                }
              ],
              "autoscale": true,
              "precision": 2,
              "timeseries_background": {
                "type": "area",
                "yaxis": {
                  "include_zero": true
                }
              }
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "Postgres query p95",
              "type": "query_value",
