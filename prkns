              "type": "timeseries",
              "show_legend": false,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "logs",
                      "name": "q",
                      "search": {
                        "query": "$cluster $namespace $service"
                      },
                      "indexes": [
                        "*"
                      ],
                      "compute": {
                        "aggregation": "count"
                      },
                      "group_by": [
                        {
                          "facet": "status",
