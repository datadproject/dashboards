              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "h",
                      "query": "sum:trace.celery.run.hits{$cluster,$env,$service}.as_rate()",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "h"
